# Gemini (ears + backup brain)
GEMINI_API_KEY=your_key_here

# DeepSeek (primary brain)
DEEPSEEK_API_KEY=your_key_here

# Groq (optional, fastest: brain + whisper ears) — https://console.groq.com
GROQ_API_KEY=

# Grok (xAI) via an OpenAI-compatible gateway — primary brain here
GROK_API_KEY=
GROK_BASE_URL=https://api.openlux.ai/v1
GROK_MODEL=grok-4.7

# Fish Audio (your cloned Jarvis voice)
FISH_API_KEY=your_key_here
FISH_VOICE_ID=your_voice_id_here
FISH_MODEL=s2.1-pro-free

# Gmail (IMAP/SMTP, App Password). Turn on 2-Step Verification, then create an App
# Password at https://myaccount.google.com/apppasswords. Replies are saved as drafts only.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_POLL_INTERVAL_S=300

# provider:model chain, tried in order (missing keys are skipped)
JARVIS_LLM_CHAIN=grok:grok-4.7,groq:llama-3.3-70b-versatile,deepseek:deepseek-chat,gemini:gemini-3.5-flash

# Screenshot vision, tried in order (Grok's gateway accepts OpenAI-style image messages)
JARVIS_VISION_CHAIN=grok:grok-4.7,gemini:gemini-3-flash-preview

# Speech to text. Each Gemini model has its OWN 20/day free quota, so a 429 rolls on.
JARVIS_STT_CHAIN=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash
JARVIS_STT_MODEL=gemini-3.5-flash-lite
JARVIS_STT_FALLBACK=gemini-3-flash-preview

# Local Whisper (pip install faster-whisper): offline, unlimited hearing on the CPU.
JARVIS_WHISPER=auto
JARVIS_WHISPER_MODEL=tiny.en
JARVIS_WHISPER_THREADS=2

# Voice engine: sapi (offline, instant) | edge (neural) | fish (clone) | auto
JARVIS_TTS=sapi
JARVIS_EDGE_VOICE=en-GB-RyanNeural
JARVIS_FISH_BUDGET_MS=4500

# Models (change without touching code)
JARVIS_CHAT_MODEL=gemini-3.8-flash
JARVIS_STT_MODEL=gemini-3.5-transcribe
JARVIS_STT_FALLBACK=gemini-3.8-flash

# Wake word
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.55
JARVIS_WAKE_FRAMES=2

# Audio (index or name; leave blank for system default)
JARVIS_MIC=
JARVIS_SPEAKER=
JARVIS_SPEECH_RMS=0.018
JARVIS_END_SILENCE_MS=750
JARVIS_PREROLL_MS=320
JARVIS_FOLLOWUP_MS=8000
JARVIS_BARGE_IN=1

# Behaviour
JARVIS_USER_TITLE=sir
JARVIS_MAX_HISTORY=16
JARVIS_SHOW_ORB=1
JARVIS_ORB_SIZE=210
JARVIS_ORB_MARGIN=36

# Hotkeys
JARVIS_HOTKEY_LISTEN=<ctrl>+<space>
JARVIS_HOTKEY_MUTE=<ctrl>+<alt>+j
JARVIS_HOTKEY_PANIC=<ctrl>+<alt>+<esc>
